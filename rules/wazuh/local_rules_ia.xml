<!-- Phase 07 — Intégrité de la couche IA (ajouté à /var/ossec/etc/rules/local_rules.xml) -->
<group name="ia_integrite,syscheck,">
  <rule id="100300" level="12">
    <if_sid>550</if_sid>
    <field name="file">/waf-ia/models/</field>
    <description>IA : fichier de modele modifie ($(file))</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>
  <rule id="100301" level="12">
    <if_sid>553</if_sid>
    <field name="file">/waf-ia/models/</field>
    <description>IA : fichier de modele supprime ($(file))</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>
  <rule id="100302" level="10">
    <if_sid>554</if_sid>
    <field name="file">/waf-ia/models/</field>
    <description>IA : nouveau fichier dans le dossier des modeles ($(file))</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>
  <rule id="100303" level="10">
    <if_sid>550,553</if_sid>
    <field name="file">/waf-ia/src/security/|/waf-ia/data/processed/</field>
    <description>IA : manifeste ou donnee d'entrainement modifie ($(file))</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>
</group>
